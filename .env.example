# Copy to .env and fill in. .env is gitignored; never commit real keys.

# Required
DASHSCOPE_API_KEY=your-dashscope-api-key
# OpenAI-compatible endpoint that supports the Responses API (see the DashScope docs for your region)
LLM_BASE_URL=https://your-dashscope-compatible-endpoint/v1
LLM_MODEL=your-qwen-model-name

# Optional (defaults shown)
# DB_PATH=sample.db          # relative paths resolve against backend/
# LLM_ENABLE_THINKING=true
# LLM_TIMEOUT_S=60
